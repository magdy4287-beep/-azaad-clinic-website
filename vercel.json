{
  "version": 2,
  "buildCommand": "python3 qa/vercel-build.py",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/admin.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/admin/admin/admin/admin/:path*", "destination": "/admin.html", "permanent": false },
    { "source": "/admin/admin/admin/:path*", "destination": "/admin.html", "permanent": false },
    { "source": "/admin/admin/:path*", "destination": "/admin.html", "permanent": false }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!*.md' ':!docs/**'",
  "git": {
    "deploymentEnabled": true
  }
}
